# ============================================
# MCMer 环境配置
# ============================================

# --- LLM 配置 ---
# 默认模型 (litellm 格式: provider/model_name)
DEFAULT_MODEL=openai/gpt-4o
# 备用模型
FALLBACK_MODEL=openai/gpt-4o-mini

# 各 Agent 专用模型 (可选，不设置则使用 DEFAULT_MODEL)
COORDINATOR_MODEL=
MODELER_MODEL=openai/gpt-4o
CODER_MODEL=openai/gpt-4o
WRITER_MODEL=anthropic/claude-3-5-sonnet-20241022

# API Keys (litellm 会自动读取标准环境变量)
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# --- Code Interpreter 配置 ---
# local, e2b, daytona
CODE_INTERPRETER=local
E2B_API_KEY=
DAYTONA_API_KEY=

# --- Redis 配置 ---
REDIS_URL=redis://localhost:6379/0

# --- 服务配置 ---
ENV=DEV
HOST=0.0.0.0
PORT=8000

# --- Agent 配置 ---
MAX_CHAT_TURNS=30
MAX_RETRIES=5
MAX_MEMORY=12

# --- 工作目录 ---
WORK_DIR=./project/work_dir

# --- 日志级别 ---
LOG_LEVEL=INFO