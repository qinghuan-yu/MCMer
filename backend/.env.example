# ============================================
# MCMer 环境配置
# ============================================

# --- LLM 配置 ---
# 默认模型 (litellm 格式: provider/model_name)
DEFAULT_MODEL=openai/gpt-4.1
# 备用模型
FALLBACK_MODEL=openai/gpt-4.1-mini

# 各 Agent 专用模型 (可选，不设置则使用 DEFAULT_MODEL)
COORDINATOR_MODEL=
MODELER_MODEL=openai/gpt-4.1
CODER_MODEL=openai/gpt-4.1
WRITER_MODEL=anthropic/claude-sonnet-4-20250514

# API Keys (litellm 会自动读取标准环境变量)
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
LLM_PROXY_URL=
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# --- Code Interpreter 配置 ---
# local, e2b, daytona
CODE_INTERPRETER=local
E2B_API_KEY=
DAYTONA_API_KEY=

# --- Redis 配置 ---
REDIS_URL=redis://localhost:6379/0

# --- 服务配置 ---
ENV=DEV
HOST=0.0.0.0
PORT=8000

# --- Agent 配置 ---
MAX_CHAT_TURNS=30
MAX_RETRIES=5
MAX_MEMORY=12
LLM_REQUEST_TIMEOUT=120
WORKFLOW_MODE=standard
CODER_MAX_TOTAL_TOOL_CALLS=8
CODER_MAX_WALL_SECONDS=180
# solve 阶段通常需要覆盖更多子问题、制图和结构化落盘，建议单独给更高工具调用预算
SOLVE_CODER_MAX_TOTAL_TOOL_CALLS=16
# solve 阶段通常需要覆盖更多子问题与出图，建议单独给更高预算
SOLVE_CODER_MAX_WALL_SECONDS=420

# --- 工作目录 ---
WORK_DIR=../work_dir

# --- 日志级别 ---
LOG_LEVEL=INFO
IGNORE_SYSTEM_PROXY=true
